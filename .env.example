# Copy this to repo-root .env; never commit actual keys.
TINYFISH_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL=gemini-2.0-flash-001
# Safe defaults: no real external calls until explicitly enabled by Ansh.
USE_STUBS=1
USE_CACHE=1
TINYFISH_LIVE_ENABLED=0
TINYFISH_BUDGET_STAGE=development

# Fixed TinyFish budget from the team's dashboard ($0.25 per outbound request).
TINYFISH_COST_PER_REQUEST_USD=0.25
TINYFISH_BUDGET_TOTAL_USD=16.00
TINYFISH_BUDGET_FINAL_RESERVE_USD=4.00
TINYFISH_MAX_REQUESTS_DEVELOPMENT=48
TINYFISH_MAX_REQUESTS_TOTAL=64
MAX_AGENT_RUNS=2
MAX_RESEARCH_RUNS=1
MAX_MONITORS=1
MAX_RESEARCH_POLLS_PER_RUN=3
# All requests, including failures and polls, count against the TinyFish caps.

# Conservative scan caps.
MAX_PACKAGES_PER_SCAN=100
MAX_PACKAGES_ANALYZED_PER_SCAN=4
SEARCH_QUERIES_PER_PACKAGE=2
MAX_URLS_FETCHED_PER_PACKAGE=2
GEMINI_MAX_PAGES=5
GEMINI_MAX_CHARS_PER_PAGE=3000
GEMINI_MAX_CONCURRENCY=1
TINYFISH_MAX_CONCURRENCY=1

# Monitoring is opt-in, and any demo monitor must be paused immediately.
MONITOR_CRON=0 0 1 1 *
RESEARCH_TIMEOUT_S=900
RESEARCH_POLL_S=10

DB_PATH=./depshield.db
CORS_ORIGINS=http://localhost:3000

# frontend/.env.local (Ayush sets after the backend URL is confirmed)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_USE_MOCKS=1
